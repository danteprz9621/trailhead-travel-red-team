# Real key required for promptfoo's attack generation + grading
# (npx promptfoo redteam run) -- unlike deepeval-capstone/ragas-capstone,
# this phase isn't free/local end-to-end. Custom plugins
# (custom-plugins/fabricated-policy.yaml) specifically require this;
# there's no local-model fallback for those.
OPENAI_API_KEY=your-openai-api-key-here

# Llama Guard classifier endpoint (llama_guard.py) -- can point at Ollama
# locally (http://localhost:11434/v1, api_key can be any placeholder) if
# you've pulled a Llama Guard model there, or a hosted OpenAI-compatible
# provider (Groq/Together/Fireworks) for the full Llama Guard 4 12B.
GUARD_BASE_URL=http://localhost:11434/v1
GUARD_API_KEY=ollama
